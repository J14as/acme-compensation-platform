# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/backend/log/*
/backend/tmp/*
!/backend/log/.keep
!/backend/tmp/.keep

# Ignore pid files
/backend/tmp/pids/*

# Ignore SQLite databases and WAL files
/backend/storage/*.sqlite3*
/backend/db/*.sqlite3*

# Frontend build & deps
frontend/node_modules/
frontend/dist/

# OS and Editor files
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
